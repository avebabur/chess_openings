#!/bin/bash
# Runs the fast checks before every commit (both Claude Code and Codex commit
# through git, so this covers them both). A commit that only changes Markdown
# skips them. Turned on per clone by: git config core.hooksPath .githooks
# Agents: never bypass this with --no-verify; fix what fails.
if ! git diff --cached --name-only | grep -qvE '\.md$'; then
  exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-commit: ./check-all.sh (fast checks)"
./check-all.sh || { echo; echo "Commit stopped: fix the failures above."; exit 1; }
