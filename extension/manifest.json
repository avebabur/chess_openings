{
  "manifest_version": 3,
  "name": "Openings for Lichess",
  "version": "0.6.0",
  "description": "Lichess plus your openings app: your Stockfish in Lichess's own analysis, your repertoire, your games and your mistakes, paused during live games. Chrome only.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "http://127.0.0.1:8001/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Openings for Lichess",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "run_at": "document_start",
      "js": [
        "src/engine-select.js"
      ]
    },
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "src/page-bridge.js"
      ]
    },
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "run_at": "document_idle",
      "js": [
        "vendor/chess.js",
        "src/anchors.js",
        "src/lichess.js",
        "src/bridge-extension.js",
        "src/core.js",
        "src/styles.js",
        "src/page-style.js",
        "src/features/engine.js",
        "src/features/mistake.js",
        "src/features/game.js",
        "src/features/repertoire.js",
        "src/features/mine.js",
        "src/features/explorerleft.js",
        "src/features/puzzles.js",
        "src/features/puzzlemenu.js",
        "src/content.js"
      ]
    }
  ],
  "minimum_chrome_version": "116"
}
